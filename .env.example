# Public, non-secret frontend deployment path. Root hosting uses "/".
VITE_BASE_PATH=/

# Build-time audio generation only. Never expose these as VITE_ variables.
TTS_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_DEFAULT_ENGLISH_SPEAKER=
SARVAM_DEFAULT_HINDI_SPEAKER=
SARVAM_DEFAULT_TELUGU_SPEAKER=
SARVAM_DEFAULT_KANNADA_SPEAKER=
SARVAM_DEFAULT_TAMIL_SPEAKER=
SARVAM_DEFAULT_MARATHI_SPEAKER=
